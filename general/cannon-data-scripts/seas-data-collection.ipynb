   "id": "be5cd499-5ae2-4156-8950-5ced129b9ce2",
   "metadata": {},
   "source": [
    "## Uploading csvs into dataframe ##\n",
    "for filename in raw_files:\n",
    "    df = pd.read_csv(filename, sep='____'  , engine='python', index_col=None, header=0)\n",
